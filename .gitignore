# Secrets / private config — never commit values
.env
config/companies.csv
config/companies.active*.csv
config/companies.csv.bak
config/discovery/
# Personal runbook: the manual half of the system (gh commands, secrets setup).
# No secret values in it, but it is a private runbook, not project documentation.
NOTES.local.md
# The resume corpus V2 scores against: employer history, work authorization,
# education. Real PII, and the most sensitive file in the working tree.
# Every version, not just the master, so a tailored variant cannot slip in.
config/resume.yaml
config/resume.*.yaml
!config/resume.example.yaml
# Extra board refs for the discovery probe — real company identifiers.
config/probe_extra_refs.json
# Terms the pre-commit hook blocks from being committed. Holding them in the
# repo would be the leak it exists to prevent.
config/private-terms.txt
*.key
*.pem
**/keyfile*.json
~/.gcp/

# Data artifacts
*.duckdb
*.duckdb.wal
*.parquet
/data/

# OS / editor / runtime artifacts
.DS_Store
.vscode/
ingest_summary.json

# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage

# dbt (dbt/profiles.yml is committed — it is env-var driven, no secret values)
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml
.vscode/
